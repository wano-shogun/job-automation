# Profile and Answers Configuration
PROFILE_PATH=~/.job-automation/profile.json
ANSWERS_PATH=~/.job-automation/answers.json

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_TYPE=chrome

# Selenium Configuration
SELENIUM_IMPLICIT_WAIT=10
SELENIUM_PAGE_LOAD_TIMEOUT=30

# Application Database
DB_PATH=~/.job-automation/applications.db

# Anthropic API (for future Claude integration)
# ANTHROPIC_API_KEY=your-key-here
